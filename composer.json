{
    "name": "tinywan/webman-horizon",
    "type": "library",
    "description": "Dashboard and code-driven configuration for Webman Redis Queue",
    "keywords": [
        "webman",
        "workerman",
        "horizon",
        "queue",
        "redis-queue",
        "dashboard"
    ],
    "homepage": "https://github.com/tinywan/webman-horizon",
    "license": "MIT",
    "authors": [
        {
            "name": "Tinywan",
            "email": "tinywan@gmail.com",
            "homepage": "https://github.com/tinywan"
        }
    ],
    "require": {
        "php": ">=8.2",
        "workerman/webman-framework": "^1.4|^1.5|^2.0",
        "webman/redis-queue": "^1.0|^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "plugin\\horizon\\": "./"
        },
        "files": [
            "app/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "plugin\\horizon\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "format:check": "mago format --check",
        "format": "mago format",
        "lint": "mago lint",
        "analyze": "mago analyze",
        "test": "pest",
        "test:docker": "docker exec -w /var/www/ai/webman-horizon dnmp-php82 ./vendor/bin/pest",
        "migrate": "phinx migrate",
        "migrate:rollback": "phinx rollback",
        "check": [
            "@format:check",
            "@lint",
            "@analyze",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
